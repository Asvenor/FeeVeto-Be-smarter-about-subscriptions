{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feeveto",
  "main": "worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "FEEVETO_ALTERNATIVES",
      "id": "cb8a5e7564cf4d3f8c3ace6cc712b69e"
    }
  ]
}
